# GrantMap Canada — Environment Variables
# Copy to .env.local and fill in your values

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Recommended for Vercel: openai (gpt-4o-mini is fast and cheap)
# Options: openai | anthropic | google | ollama
AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Local Ollama (only needed for local dev with Ollama running)
# Leave empty on Vercel — the app auto-detects and skips Ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:latest

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get from https://dashboard.stripe.com/webhooks after creating the endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Pre-created Stripe Price IDs (optional — app creates inline prices if not set)
# Create at: https://dashboard.stripe.com/products
STRIPE_PRICE_ID_REPORT=price_...      # $150 CAD one-time payment
STRIPE_PRICE_ID_MONTHLY=price_...     # $50 CAD/month subscription

# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
# Required on Vercel. Get from https://neon.tech (free tier available)
# Leave empty for local dev — app falls back to SQLite automatically
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Auth (optional — only needed if NextAuth is wired up)
NEXTAUTH_SECRET=change-this-to-a-random-string
NEXTAUTH_URL=http://localhost:3003
